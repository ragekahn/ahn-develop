# ---- LLM provider: "openai", "anthropic", or "ollama" ----
LLM_PROVIDER=openai

# API keys (put your REAL key in .env, which is git-ignored)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ---- Ollama (local, no API key needed) ----
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Optional overrides ----
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ---- Toss Invest broker / market data (Korean market) ----
# Required when BROKER=tossinvest. Read directly from the environment by
# stockbot.tossinvest_client.TossInvestClient (not via config.py).
TOSSEST_CLIENT_ID=your-tossinvest-client-id
TOSSEST_CLIENT_SECRET=your-tossinvest-client-secret
